{
  "planVersion": "1.0",
  "server": {
    "runtime": "net10.0",
    "supportedArchitectures": [
      "linux/arm64",
      "linux/amd64"
    ],
    "apiPort": 8088,
    "defaultApiBind": "127.0.0.1",
    "dataRoot": "/data",
    "stateRoot": "/config",
    "singleInstance": true,
    "sqliteBusyTimeoutMs": 5000,
    "sqliteJournalMode": "WAL",
    "sqliteSynchronous": "FULL",
    "gracefulShutdownSeconds": 60,
    "auditRetentionDays": 30
  },
  "auth": {
    "passwordMinLength": 12,
    "passwordMaxLength": 128,
    "tokenRandomBytes": 32,
    "accessTokenMinutes": 15,
    "refreshTokenAbsoluteDays": 30,
    "bootstrapCodeMinutes": 30,
    "devicePairingMinutes": 5,
    "devicePairingCodeLength": 8,
    "pairingPollSeconds": 5,
    "loginAttemptsPerMinutePerIp": 10,
    "loginAttemptsPerMinutePerAccount": 5
  },
  "downloads": {
    "sequential": true,
    "firstLastMetadataAssist": true,
    "seekAwarePrioritization": false,
    "activeGlobal": 2,
    "activePerUser": 1,
    "activeSeeds": 2,
    "metadataConcurrency": 1,
    "metadataTimeoutSeconds": 120,
    "provisionalReservationBytes": 268435456,
    "torrentUploadMaxBytes": 16777216,
    "metainfoMaxFiles": 10000,
    "metainfoMaxDepth": 64,
    "metainfoMaxPathBytes": 4096,
    "globalConnections": 100,
    "connectionsPerTorrent": 40,
    "globalUploadBytesPerSecond": 2097152,
    "globalDownloadBytesPerSecond": null,
    "defaultRatioLimit": null,
    "defaultSeedTimeMinutes": null,
    "autoDeleteOnRatio": false,
    "lowDiskFloorBytes": 5368709120,
    "lowDiskFloorFraction": 0.05,
    "userQuotaBytes": null,
    "torrentUploadExpiryMinutes": 30,
    "maxPieceLengthBytes": 67108864
  },
  "discovery": {
    "pageSize": 50,
    "maxPageSize": 200,
    "maxResultsPerSnapshot": 500,
    "cacheSeconds": 300,
    "recentRefreshSeconds": 900,
    "staleMaxSeconds": 86400,
    "upstreamTimeoutSeconds": 20,
    "upstreamConcurrency": 2,
    "activeQueriesPerUser": 1,
    "queryMaxLength": 200
  },
  "playback": {
    "startupPrefixBytes": 16777216,
    "piecePollActiveMs": 500,
    "piecePollDownloadMs": 2000,
    "snapshotMaxAgeMs": 2000,
    "waitBeforeHeadersSeconds": 60,
    "midstreamIdleSeconds": 120,
    "copyBufferBytes": 262144,
    "rangeRequestsPerSession": 4,
    "rangeRequestsGlobal": 16,
    "ticketFirstUseMinutes": 10,
    "ticketIdleMinutes": 30,
    "ticketAbsoluteHours": 24,
    "permissionRecheckSeconds": 1,
    "progressWriteSeconds": 15,
    "watchedFraction": 0.95,
    "desktopCacheBytes": 67108864,
    "androidCacheBytes": 33554432
  },
  "media": {
    "probeConcurrency": 1,
    "probeTimeoutSeconds": 20,
    "probeOutputMaxBytes": 1048576,
    "thumbnailConcurrency": 1,
    "thumbnailCacheMaxBytes": 536870912,
    "thumbnailMaxEdge": 480,
    "imageMaxDecodedPixels": 40000000,
    "slideshowSeconds": 5,
    "trashRetentionDays": 7,
    "scanIntervalSeconds": 3600
  },
  "events": {
    "keepaliveSeconds": 15,
    "visibleProgressMaxHz": 1,
    "pollFallbackSeconds": 5,
    "maxBufferedEventsPerClient": 100,
    "maxSseConnectionsPerUser": 3
  },
  "ui": {
    "theme": "system",
    "density": "comfortable",
    "libraryLayout": "grid",
    "playbackMode": "internal",
    "showFilenameExtensions": true,
    "showContinueWatching": true,
    "rememberFolderSort": true,
    "defaultPlaybackSpeed": 1.0,
    "subtitleScale": 1.0,
    "resumePolicy": "ask",
    "locale": "en",
    "accentPreset": "blue",
    "pinnedLibraryIds": [],
    "torrentColumns": [
      "title",
      "size",
      "seeders",
      "leechers"
    ],
    "preferredAudioLanguage": null,
    "preferredSubtitleLanguage": null,
    "keyboardShortcutPreset": "standard",
    "discoveryViews": []
  }
}
