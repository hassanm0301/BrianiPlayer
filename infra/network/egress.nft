# Only this container's network namespace is affected. Priority precedes Docker
# embedded-DNS destination NAT, so the DNS exception remains port-specific.
table inet briani_egress {
  set denied_v4 {
    type ipv4_addr; flags interval;
    elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8,
      169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24,
      192.88.99.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24,
      224.0.0.0/4, 240.0.0.0/4 }
  }
  chain output {
    type filter hook output priority -150; policy drop;
    ct state established,related counter accept
    ip daddr 127.0.0.11 meta l4proto { tcp, udp } th dport 53 counter accept
    ip daddr @denied_v4 counter reject
    # Only public global-unicast IPv6; deny transition mechanisms which could
    # encapsulate a forbidden IPv4 destination, and the documentation range.
    ip6 daddr { ::/3, 2001::/23, 2001:db8::/32, 2002::/16, 3ffe::/16, 3fff::/20, 4000::/2, 8000::/1 } counter reject
    meta nfproto ipv4 counter accept
    ip6 daddr 2000::/3 counter accept
    counter reject
  }
}
